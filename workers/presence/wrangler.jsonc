{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xuan-le-online-presence",
  "main": "src/index.js",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PRESENCE",
        "class_name": "PresenceRoom"
      }
    ]
  },
  "exports": {
    "PresenceRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://sunflower1509.github.io,http://localhost:8080,http://127.0.0.1:8080"
  }
}
